# RahBaz -> T3 Code "Claude" provider instance preset.
# Enter these in T3 -> Settings -> Providers -> Claude instance -> Environment variables
# (NOT Launch arguments). Do not commit real keys.

# RahBaz gateway (loopback only)
ANTHROPIC_BASE_URL=http://127.0.0.1:8317

# Gateway API key = api-keys[0] from config/config.yaml. Mark Sensitive in T3.
ANTHROPIC_AUTH_TOKEN=<rahbaz-gateway-api-key>

# Must be set EXPLICITLY EMPTY so Claude Code never falls back to a direct Anthropic key.
ANTHROPIC_API_KEY=

# Also set in the T3 instance (not an env var here):
#   CLAUDE_CONFIG_DIR = C:\Users\<you>\.claude_rahbaz
# If that dir ever logged into Anthropic directly, run /logout once in it.
